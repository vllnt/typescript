{
  "name": "@vllnt/typescript",
  "version": "2.0.0",
  "description": "Shared TypeScript configurations for vllnt projects",
  "license": "MIT",
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "homepage": "https://github.com/vllnt/typescript#readme",
  "bugs": {
    "url": "https://github.com/vllnt/typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vllnt/typescript.git"
  },
  "keywords": [
    "typescript",
    "tsconfig",
    "config",
    "shared-config"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "base.json",
    "nextjs.json",
    "nodejs.json",
    "node-library.json",
    "react.json",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./nextjs.json": "./nextjs.json",
    "./nodejs.json": "./nodejs.json",
    "./node-library.json": "./node-library.json",
    "./react.json": "./react.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm check:agents && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --dir tests/integration/react build && pnpm --dir tests/integration/nextjs build",
    "check": "pnpm format:check && pnpm lint && pnpm test:coverage && pnpm test:integration",
    "prepublishOnly": "pnpm check",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\""
  },
  "peerDependencies": {
    "typescript": ">=6.0.2 <8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vllnt/eslint-config": "2.0.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
